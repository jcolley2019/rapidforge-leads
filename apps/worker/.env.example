# RapidForge worker environment (PRD Section 9).
# Copy to .env and fill in. The worker holds ALL secrets — nothing here may
# ever appear in apps/web or get a VITE_ prefix.

# Supabase → Project Settings → API. The service-role key BYPASSES RLS;
# it exists only here, never in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud Console → APIs & Services → Credentials.
# Server key for Places API (New) — IP-restrict it to your machine.
GOOGLE_PLACES_API_KEY=

# Google Cloud Console → enable "PageSpeed Insights API" → API key.
PAGESPEED_API_KEY=

# Yelp Fusion (v1.5 Reputation agent) — https://www.yelp.com/developers
YELP_API_KEY=

# Anthropic Console → API keys. Consumed ONLY via RapidForge AI Core.
ANTHROPIC_API_KEY=

# Local worker HTTP port.
WORKER_PORT=8788

# RFL.DEMO.1 — the Build demo button. Absolute path of the rapidforge-demos
# checkout on this machine; the worker spawns `npm run demo -- --lead <id>`
# there (that repo's own .env holds its Vercel + Supabase keys). Unset →
# POST /api/businesses/:id/demo answers 503 "DEMOS_DIR not configured".
DEMOS_DIR=

# Opt-in audit switches (all off by default — each one costs a call).
# PSI_DESKTOP=true        — run a second PageSpeed strategy; otherwise the
#                           desktop term reuses the mobile run and Health
#                           says "desktop not measured".
# SCREENSHOTS_ENABLED=true — capture desktop+mobile screenshots so Design
#                           runs the Sonnet vision critique (~2c/audit);
#                           otherwise Design is a markup-only estimate.
# AI_SUMMARIES=reputation — narrate the named agents on Haiku; a comma list
#                           (health,conversion,presence,reputation,seo) or
#                           "haiku" for all five; unset = templates.
# PSI_DESKTOP=true
# SCREENSHOTS_ENABLED=true
# AI_SUMMARIES=reputation

# Set to "true" to pin every EXTERNAL-API seam (places, probe, site, psi, ai)
# to fixture/template mode even when keys are present — UI/E2E testing never
# spends real quota. Does NOT affect the Supabase store (Realtime needs it).
RAPIDFORGE_FORCE_FIXTURES=
