# RapidForge web environment (PRD Section 9).
# Copy to .env and fill in. ONLY browser-safe values ever get the VITE_
# prefix — Vite inlines these into the shipped bundle. The service-role
# key, Places server key, PSI key, and Anthropic key live in
# apps/worker/.env and must NEVER appear here.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase → Project Settings → API → anon public key (RLS enforced)
VITE_SUPABASE_ANON_KEY=

# v1.5 (map-draw mode): referrer-restricted Google Maps JS browser key.
# VITE_GOOGLE_MAPS_BROWSER_KEY=
